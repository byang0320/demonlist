generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
}

enum LevelStatus {
  ACTIVE
  ARCHIVED
}

model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      AdminRole @default(ADMIN)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Player {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  bio         String?
  avatarUrl   String?
  externalUrl String?
  country1    String?
  country2    String?
  completions Completion[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Level {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  rank         Int
  type         String
  demoted      Boolean      @default(false)
  unrated      Boolean      @default(false)
  publishedBy  String
  createdBy    String?
  verifiedBy   String?
  description  String?
  thumbnailUrl String?
  externalUrl  String?
  status       LevelStatus  @default(ACTIVE)
  completions  Completion[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([type, rank])
  @@index([status, type, rank])
}

model Completion {
  id          String    @id @default(cuid())
  playerId    String
  levelId     String
  times       Int       @default(1)
  completedAt DateTime?
  videoUrl    String?
  notes       String?
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  level       Level     @relation(fields: [levelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([playerId, levelId])
  @@index([playerId])
  @@index([levelId])
}
